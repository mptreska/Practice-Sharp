<Window x:Class="MedicalRecords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинские записи" Height="600" Width="900"
        Background="#EAF0FB">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Медицинские записи"
                   FontSize="26" FontWeight="Bold"
                   Foreground="#2C3E50"
                   VerticalAlignment="Center"
                   Margin="10,0"/>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#CCCCCC">

            <TabItem Header="  Пациенты  " FontSize="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#F4F8FF" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Список пациентов"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>

                        <ListBox Grid.Row="1"
                                 x:Name="PatientListBox"
                                 DisplayMemberPath="FullName"
                                 SelectionChanged="PatientListBox_SelectionChanged"
                                 BorderThickness="1"
                                 BorderBrush="#CCCCCC"
                                 FontSize="13"
                                 Margin="0,0,0,5"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Добавить"
                                    Click="AddPatient_Click"
                                    Margin="5,5,3,5"/>
                            <Button Content="Удалить"
                                    Click="DeletePatient_Click"
                                    Background="#E74C3C"
                                    Margin="3,5,5,5"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PatientNameText"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <TextBlock x:Name="PatientAgeText"
                                           Foreground="#7F8C8D"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="PatientPhoneText"
                                           Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="История болезней"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>

                        <DataGrid Grid.Row="2"
                                  x:Name="RecordsDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F4F8FF"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                    Width="100"/>
                                <DataGridTextColumn Header="Диагноз"
                                    Binding="{Binding Diagnosis}"
                                    Width="160"/>
                                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="*"/>
                                <DataGridTextColumn Header="Врач"
                                    Binding="{Binding Doctor}"
                                    Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="3"
                                Content="+ Добавить запись"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Click="AddRecord_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="  Все записи  " FontSize="13">
                <DataGrid x:Name="AllRecordsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          AlternatingRowBackground="#F4F8FF"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пациент"
                            Binding="{Binding PatientName}" Width="180"/>
                        <DataGridTextColumn Header="Дата"
                            Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Диагноз"
                            Binding="{Binding Diagnosis}" Width="160"/>
                        <DataGridTextColumn Header="Описание"
                            Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Врач"
                            Binding="{Binding Doctor}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>