<Window x:Class="MedClinic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинские записи" Height="650" Width="950"
        Background="#EAF0FB">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddPatientCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding AddRecordCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditRecordCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteRecordCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- ControlTemplate для кнопки с крестом -->
        <ControlTemplate x:Key="MedicalButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="10,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="3"
                            Width="18" Height="18" Margin="0,0,6,0">
                        <TextBlock Text="✚" FontSize="12" FontWeight="Bold"
                                   Foreground="{TemplateBinding Background}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="White" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Обычный стиль кнопки -->
        <Style x:Key="DefaultButton" TargetType="Button">
            <Setter Property="Background"      Value="#4A90D9"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="3"/>
        </Style>

        <!-- DataTemplate для ListBox пациентов -->
        <DataTemplate x:Key="PatientTemplate">
            <Border Background="White" CornerRadius="6"
                    Margin="3" Padding="10"
                    BorderBrush="#CCCCCC" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка пациента -->
                    <Border Grid.Column="0"
                            Background="#4A90D9"
                            CornerRadius="20"
                            Width="36" Height="36">
                        <TextBlock Text="👤" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Инфо -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}"
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="#2C3E50"/>
                        <TextBlock Foreground="#7F8C8D" FontSize="11">
                            <Run Text="Возраст: "/>
                            <Run Text="{Binding Age}"/>
                            <Run Text=" лет"/>
                        </TextBlock>
                        <TextBlock Foreground="#7F8C8D" FontSize="11">
                            <Run Text="Тел: "/>
                            <Run Text="{Binding Phone}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="#2C3E50" Foreground="White" FontSize="13">
            <MenuItem Header="Файл" Foreground="White">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Пациенты" Foreground="White">
                <MenuItem Header="Записать пациента (Ctrl+N)"
                          Command="{Binding AddPatientCommand}"/>
            </MenuItem>
            <MenuItem Header="Записи" Foreground="White">
                <MenuItem Header="Добавить запись (Ctrl+R)"
                          Command="{Binding AddRecordCommand}"/>
                <MenuItem Header="Редактировать (Ctrl+E)"
                          Command="{Binding EditRecordCommand}"/>
                <MenuItem Header="Удалить (Del)"
                          Command="{Binding DeleteRecordCommand}"/>
            </MenuItem>
            <MenuItem Header="Настройки" Foreground="White">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="1" Background="#F4F8FF" Height="50">
            <Button Content="Записать пациента"
                    Command="{Binding AddPatientCommand}"
                    Template="{StaticResource MedicalButtonTemplate}"
                    Background="#27AE60"
                    ToolTip="Ctrl+N" Margin="5"/>
            <Separator/>
            <Button Content="Добавить запись"
                    Command="{Binding AddRecordCommand}"
                    Template="{StaticResource MedicalButtonTemplate}"
                    Background="#4A90D9"
                    ToolTip="Ctrl+R" Margin="5"/>
            <Button Content="Редактировать"
                    Command="{Binding EditRecordCommand}"
                    Style="{StaticResource DefaultButton}"
                    ToolTip="Ctrl+E"/>
            <Button Content="🗑️ Удалить"
                    Command="{Binding DeleteRecordCommand}"
                    Style="{StaticResource DefaultButton}"
                    Background="#E74C3C"
                    ToolTip="Delete"/>
        </ToolBar>

        <!-- Заголовок -->
        <TextBlock Grid.Row="2"
                   Text="Медицинские записи"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="15,8"/>

        <!-- TabControl -->
        <TabControl Grid.Row="3" Background="White" Margin="10">

            <!-- Вкладка 1: Пациенты -->
            <TabItem Header="  Пациенты  " FontSize="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список пациентов с DataTemplate -->
                    <Grid Grid.Column="0" Background="#F4F8FF" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Список пациентов"
                                   FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0"/>

                        <!-- ListBox с DataTemplate -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Patients}"
                                 SelectedItem="{Binding SelectedPatient}"
                                 ItemTemplate="{StaticResource PatientTemplate}"
                                 BorderBrush="#CCCCCC"
                                 Background="#F4F8FF"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Button Grid.Row="2"
                                Content="Записать пациента"
                                Command="{Binding AddPatientCommand}"
                                Template="{StaticResource MedicalButtonTemplate}"
                                Background="#27AE60"
                                Margin="5"/>
                    </Grid>

                    <!-- Правая панель -->
                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TwoWay привязка - редактирование пациента -->
                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="ФИО:" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Grid.ColumnSpan="3"
                                         Text="{Binding SelectedPatient.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Возраст:" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SelectedPatient.Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="Телефон:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Text="{Binding SelectedPatient.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4" Margin="0,3"/>
                            </Grid>
                        </Border>

                        <!-- Фильтрация по дате -->
                        <Border Grid.Row="1"
                                Background="#F4F8FF"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Фильтр по дате:"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <DatePicker x:Name="FilterDatePicker"
                                            SelectedDateChanged="FilterDatePicker_Changed"
                                            Width="150"/>
                                <Button Content="Сбросить"
                                        Click="ResetFilter_Click"
                                        Style="{StaticResource DefaultButton}"
                                        Background="#95A5A6"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="История болезней"
                                   FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- OneWay привязка для списка приёмов -->
                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding FilteredRecords, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  AlternatingRowBackground="#F4F8FF"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                    Width="100"/>
                                <DataGridTextColumn Header="Диагноз"
                                    Binding="{Binding Diagnosis}" Width="160"/>
                                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Врач"
                                    Binding="{Binding Doctor}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Все записи -->
            <TabItem Header="  Все записи  " FontSize="13">
                <DataGrid ItemsSource="{Binding AllRecords, Mode=OneWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          AlternatingRowBackground="#F4F8FF"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пациент"
                            Binding="{Binding PatientName}" Width="180"/>
                        <DataGridTextColumn Header="Дата"
                            Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Диагноз"
                            Binding="{Binding Diagnosis}" Width="160"/>
                        <DataGridTextColumn Header="Описание"
                            Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Врач"
                            Binding="{Binding Doctor}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>