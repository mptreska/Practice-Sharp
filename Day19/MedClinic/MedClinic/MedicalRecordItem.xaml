<UserControl x:Class="MedClinic.MedicalRecordItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,3">

    <UserControl.Resources>
        <!-- Анимация появления -->
        <Storyboard x:Key="FadeInRecord">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.5"/>
            <DoubleAnimation
                Storyboard.TargetName="RootBorder"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="-50" To="0"
                Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Анимация раскрытия деталей -->
        <Storyboard x:Key="ExpandDetails">
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="MaxHeight"
                From="0" To="200"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Анимация сворачивания деталей -->
        <Storyboard x:Key="CollapseDetails">
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="MaxHeight"
                From="200" To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.2"/>
        </Storyboard>

    </UserControl.Resources>

    <Border x:Name="RootBorder"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            Cursor="Hand"
            MouseLeftButtonDown="Record_Click">

        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>

        <!-- Эффект тени -->
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="8"
                              Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Style.Triggers>
                    <!-- Подсветка при наведении -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F7FF"/>
                        <Setter Property="BorderBrush" Value="#4A90D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <!-- Основная строка -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Цветовой индикатор важности -->
                <Border Grid.Column="0"
                        x:Name="ImportanceIndicator"
                        Width="6" CornerRadius="3"
                        Margin="0,0,10,0"
                        Background="#4A90D9"/>

                <!-- Диагноз и врач -->
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="DiagnosisText"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#2C3E50"/>
                    <TextBlock x:Name="DoctorText"
                               FontSize="11"
                               Foreground="#7F8C8D"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Дата -->
                <TextBlock Grid.Column="2"
                           x:Name="DateText"
                           FontSize="11"
                           Foreground="#95A5A6"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <!-- Стрелка раскрытия -->
                <TextBlock Grid.Column="3"
                           x:Name="ArrowText"
                           Text="▼"
                           FontSize="10"
                           Foreground="#95A5A6"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Детали (раскрываются по клику) -->
            <StackPanel x:Name="DetailsPanel"
                        MaxHeight="0"
                        Opacity="0"
                        Margin="16,0,0,0">
                <Separator Margin="0,8"/>

                <TextBlock Text="Описание:"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#2C3E50"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="DescriptionText"
                           FontSize="12"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="ImportanceBadge"
                            CornerRadius="10"
                            Padding="8,3"
                            Background="#4A90D9">
                        <TextBlock x:Name="ImportanceText"
                                   FontSize="11"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>