<Window x:Class="MedClinic.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись" Height="420" Width="400"
        MinHeight="420" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="#EAF0FB"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Диагноз:"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="DiagnosisBox"
                 Padding="6" Margin="0,0,0,10"
                 BorderBrush="#CCCCCC" BorderThickness="1"/>

        <TextBlock Grid.Row="2" Text="Описание:"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="DescriptionBox"
                 Padding="6" Height="55"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Margin="0,0,0,10"
                 BorderBrush="#CCCCCC" BorderThickness="1"/>

        <TextBlock Grid.Row="4" Text="Врач:"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5" x:Name="DoctorBox"
                 Padding="6" Margin="0,0,0,10"
                 BorderBrush="#CCCCCC" BorderThickness="1"/>

        <TextBlock Grid.Row="6" Text="Дата:"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <DatePicker Grid.Row="7" x:Name="RecordDatePicker"
                    Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Text="Важность:"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="9" x:Name="ImportanceBox"
                  Padding="6,4" Margin="0,0,0,15"
                  BorderBrush="#CCCCCC" BorderThickness="1">
            <ComboBoxItem Tag="normal" IsSelected="True">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#4A90D9" Width="12" Height="12"
                            CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Обычная"/>
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem Tag="warning">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#F39C12" Width="12" Height="12"
                            CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Требует внимания"/>
                </StackPanel>
            </ComboBoxItem>
            <ComboBoxItem Tag="critical">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E74C3C" Width="12" Height="12"
                            CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Срочная / Критическая"/>
                </StackPanel>
            </ComboBoxItem>
        </ComboBox>

        <StackPanel Grid.Row="10" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click"
                    Background="#4A90D9" Foreground="White"
                    Padding="12,8" BorderThickness="0"
                    Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="Отмена" Click="Cancel_Click"
                    Background="#E74C3C" Foreground="White"
                    Padding="12,8" BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>