<Window x:Class="MedClinic.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#EAF0FB">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="5"
                Margin="0,0,0,10">
            <ListBox x:Name="MessagesBox"
                     BorderThickness="0"
                     Padding="5" FontSize="13"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <TextBox Grid.Row="2"
                 x:Name="InputBox"
                 Padding="8,6" FontSize="13"
                 BorderBrush="#CCCCCC" BorderThickness="1"
                 Margin="0,0,0,8"
                 KeyDown="InputBox_KeyDown"/>

        <Button Grid.Row="3"
                Content="📤 Отправить"
                Click="Send_Click"
                Background="#4A90D9" Foreground="White"
                Padding="0,10" FontSize="13"
                BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>