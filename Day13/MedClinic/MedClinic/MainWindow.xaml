<Window x:Class="MedClinic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинские записи" Height="650" Width="950"
        Background="#EAF0FB">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddPatientCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding AddRecordCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditRecordCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteRecordCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background"      Value="#4A90D9"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="#2C3E50" Foreground="White" FontSize="13">
            <MenuItem Header="Файл" Foreground="White">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Пациенты" Foreground="White">
                <MenuItem Header="Записать пациента (Ctrl+N)"
                          Command="{Binding AddPatientCommand}"/>
            </MenuItem>
            <MenuItem Header="Записи" Foreground="White">
                <MenuItem Header="Добавить запись (Ctrl+R)"
                          Command="{Binding AddRecordCommand}"/>
                <MenuItem Header="Редактировать (Ctrl+E)"
                          Command="{Binding EditRecordCommand}"/>
                <MenuItem Header="Удалить (Del)"
                          Command="{Binding DeleteRecordCommand}"/>
            </MenuItem>
            <MenuItem Header="Настройки" Foreground="White">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="1" Background="#F4F8FF" Height="45">
            <Button Content="📋 Записать пациента"
                    Command="{Binding AddPatientCommand}"
                    ToolTip="Ctrl+N"/>
            <Separator/>
            <Button Content="➕ Добавить запись"
                    Command="{Binding AddRecordCommand}"
                    ToolTip="Ctrl+R"/>
            <Button Content="✏️ Редактировать"
                    Command="{Binding EditRecordCommand}"
                    ToolTip="Ctrl+E"/>
            <Button Content="🗑️ Удалить"
                    Command="{Binding DeleteRecordCommand}"
                    Background="#E74C3C"
                    ToolTip="Delete"/>
        </ToolBar>

        <!-- Заголовок -->
        <TextBlock Grid.Row="2"
                   Text="Медицинские записи"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="15,8"/>

        <!-- TabControl -->
        <TabControl Grid.Row="3" Background="White" Margin="10">

            <!-- Вкладка 1 -->
            <TabItem Header="  Пациенты  " FontSize="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список пациентов -->
                    <Grid Grid.Column="0" Background="#F4F8FF" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Список пациентов"
                                   FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Patients}"
                                 SelectedItem="{Binding SelectedPatient}"
                                 DisplayMemberPath="FullName"
                                 FontSize="13"
                                 BorderBrush="#CCCCCC"/>

                        <Button Grid.Row="2"
                                Content="➕ Добавить пациента"
                                Command="{Binding AddPatientCommand}"
                                Margin="5"/>
                    </Grid>

                    <!-- Правая панель -->
                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Инфо о пациенте -->
                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPatient.FullName}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <TextBlock Foreground="#7F8C8D" Margin="0,3,0,0">
                                    <Run Text="Возраст: "/>
                                    <Run Text="{Binding SelectedPatient.Age}"/>
                                    <Run Text=" лет  |  Тел: "/>
                                    <Run Text="{Binding SelectedPatient.Phone}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="История болезней"
                                   FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedPatientRecords}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  AlternatingRowBackground="#F4F8FF"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                    Width="100"/>
                                <DataGridTextColumn Header="Диагноз"
                                    Binding="{Binding Diagnosis}" Width="160"/>
                                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Врач"
                                    Binding="{Binding Doctor}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2 -->
            <TabItem Header="  Все записи  " FontSize="13">
                <DataGrid ItemsSource="{Binding AllRecords}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          AlternatingRowBackground="#F4F8FF"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пациент"
                            Binding="{Binding PatientName}" Width="180"/>
                        <DataGridTextColumn Header="Дата"
                            Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Диагноз"
                            Binding="{Binding Diagnosis}" Width="160"/>
                        <DataGridTextColumn Header="Описание"
                            Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Врач"
                            Binding="{Binding Doctor}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>