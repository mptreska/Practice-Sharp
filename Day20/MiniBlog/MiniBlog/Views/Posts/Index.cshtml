@model List<MiniBlog.Models.Post>

@{
    ViewData["Title"] = "Список постов";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📝 Мини-блог</h1>
        <a asp-controller="Posts" asp-action="Create" class="btn btn-success">
            + Создать пост
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Постов пока нет. Создайте первый!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var post in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">

                            <h5 class="card-title">@post.Title</h5>

                            <p class="card-text text-muted">
                                @(post.Content.Length > 100
                                                        ? post.Content.Substring(0, 100) + "..."
                                                        : post.Content)
                    </p>

                            <small class="text-secondary">
                                📅 @post.DatePosted.ToString("dd.MM.yyyy HH:mm")
                            </small>

                            <div class="mt-3">
                                <a asp-controller="Posts"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   class="btn btn-primary btn-sm">
                                    Читать далее
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
                }
        </div>
    }

</div>